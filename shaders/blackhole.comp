#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D out_image;

layout(set = 0, binding = 1) uniform samplerCube skybox;

layout(push_constant) uniform PushConstants {
    int width;
    int height;
    float FOV;
    float time;
    mat4 camera;
} pc;

// Scene Parameters
vec3 blackHoleOrigin = vec3(0.0, 0.0, 0.0);
float blackHoleRadius = 10.0;
float blackHoleMass = 4.0;

// vec3 lightDir = normalize(vec3(1.0, -1.0, -1.0));

float sphereSDF(vec3 p, float r) {
    return length(p) - r;
}

struct HitData {
    float distance;
    vec4 color;
    vec3 newDir;
};

HitData sceneSDF(vec3 p, vec3 rayDir) {
    HitData hitData;

    hitData.distance = sphereSDF(blackHoleOrigin - p, blackHoleRadius);
    hitData.color = vec4(0.0, 0.0, 0.0, 1.0);

    float distanceToBlackHole = distance(p, blackHoleOrigin);
    hitData.newDir = normalize(rayDir + ((blackHoleOrigin - p) * hitData.distance / pow(distanceToBlackHole, 3)) * blackHoleMass); // distance = stepSize

    return hitData;
}

void main()
{
    // Camera
    vec3 right   = vec3(pc.camera[0]);
    vec3 up      = vec3(pc.camera[1]);
    vec3 forward = vec3(pc.camera[2]);
    vec3 eye     = vec3(pc.camera[3]);

    // Ray
    vec2 pixel = (vec2(gl_GlobalInvocationID.xy) + 0.5 - 0.5 * vec2(pc.width, pc.height));
    vec3 rayOrigin = eye;
    vec3 rayDir = normalize(forward * pc.FOV + right * pixel.x + up * pixel.y);

    // Ray Marching Settings
    float t = 0.0;
    float t_total = 0.0;
    const int MAX_ITERATIONS = 64;
    const float CLOSEST_DISTANCE = 0.1;
    const float MAX_DISTANCE = 1000;
    HitData hitData;

    for(int i = 0; i < MAX_ITERATIONS; ++i) {
        rayOrigin = rayOrigin + rayDir * t;

        hitData = sceneSDF(rayOrigin, rayDir);
        t_total += hitData.distance;
        t = hitData.distance;
        rayDir = hitData.newDir;

        if(hitData.distance < CLOSEST_DISTANCE || t_total > MAX_DISTANCE) break;
    }

    vec4 color;
    if(hitData.distance < CLOSEST_DISTANCE) {
        color = hitData.color;
    }
    else {
        color = texture(skybox, rayDir);
    }

    imageStore(out_image, ivec2(gl_GlobalInvocationID.xy), color);
}
